[Unit]
Description=Default route via AOS (10.21.31.103), which shares the office Wi-Fi (office-nat on AOS)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=90
# a Deno script (no imports), run by the pinned Deno setup installs
Environment=DENO_DIR=/var/cache/m20-deno DENO_NO_UPDATE_CHECK=1 NO_COLOR=1
ExecStart=/usr/local/bin/deno run --no-remote --cached-only --no-lock --no-config --no-prompt -A /usr/local/bin/aos-uplink-up

[Install]
WantedBy=multi-user.target
