[Unit]
Description=AOS shares its office Wi-Fi (wlan0) with GOS and the other boards
After=network-online.target docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
# a Deno script (no imports), run by the pinned Deno setup installs
Environment=DENO_DIR=/var/cache/m20-deno DENO_NO_UPDATE_CHECK=1 NO_COLOR=1
ExecStart=/usr/local/bin/deno run --no-remote --cached-only --no-lock --no-config --no-prompt -A /usr/local/bin/office-nat

[Install]
WantedBy=multi-user.target
