{
    "lock": false,
    "tasks": {
        "dev": "deno run -A --watch backend/main.ts",
        "fake": "M20_DASH_SOURCE=fake deno run -A backend/main.ts",
        "test": "deno test -A backend/ && deno test -A --no-check frontend/test/",
        "build": "cd frontend && npm ci && npm run build",
        "typecheck": "cd frontend && npx tsc --noEmit",
        "check": "deno check backend/main.ts && deno task check-endpoints",
        "check-endpoints": "deno run -A scripts/check_endpoints.ts",
        "fake-gateway": "deno run -A backend/fake_gateway.ts",
        "demo": "M20_DASH_SOURCE=fake M20_DASH_DESKTOP_URL=http://127.0.0.1:8790 deno run -A backend/main.ts"
    },
    "fmt": {
        "indentWidth": 4,
        "semiColons": false,
        "lineWidth": 120,
        "include": [
            "backend",
            "scripts",
            "frontend/src",
            "frontend/test"
        ],
        "exclude": [
            "frontend/src/dim-app"
        ]
    },
    "lint": {
        "include": [
            "backend",
            "scripts"
        ]
    },
    "imports": {
        "@std/assert": "jsr:@std/assert@1",
        "@std/yaml": "jsr:@std/yaml@1"
    }
}
